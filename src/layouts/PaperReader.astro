---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import type { ReaderConfig } from '../scripts/reader/config';
import { type Paper, fileUrl, originalFileName, paperUrl, pdfjsAssetsUrl } from '../utils/papers';

interface Props {
	paper: Paper;
	/** `zh`: the translation. `dual`: the copy with the original alongside. */
	variant: 'zh' | 'dual';
}

const { paper, variant } = Astro.props;
const { reading } = paper;

const file = variant === 'dual' ? paper.dualFile : paper.file;
if (!file) throw new Error(`${paper.id} has no bilingual copy`);

// The bilingual copy already shows both languages, so it is not paired with the original.
const original = variant === 'zh' ? reading.original : null;
const bilingual = variant === 'dual' || paper.bilingual;
const title = variant === 'dual' ? `${paper.title}（中英对照）` : paper.title;

const config: ReaderConfig = {
	assetsUrl: pdfjsAssetsUrl,
	main: {
		label: bilingual ? '对照版' : '译文',
		url: fileUrl(file),
		storageKey: file,
		pages: paper.pages,
		outline: variant === 'dual' ? (reading.dualOutline ?? []) : reading.outline,
	},
	original: original && {
		label: '原文',
		url: fileUrl(originalFileName(paper)),
		storageKey: originalFileName(paper),
		pages: original.pages,
		outline: original.outline,
	},
	originalSource: original?.sourceUrl ?? null,
	notice: variant === 'zh' ? (reading.notice ?? null) : null,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} - ${SITE_TITLE}`} description={`在线阅读《${paper.title}》的中文译本。`} />
	</head>
	<body>
		<div id="reader" class="reader">
			<script id="reader-config" type="application/json" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />

			<div class="chrome">
				<header id="top-bar" class="bar">
					<a class="icon-button back" href={paperUrl(paper.id)} aria-label="返回论文页" title="返回论文页">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6"></path></svg>
					</a>
					<h1 class="title">{title}</h1>

					<div class="zoom">
						<button id="zoom-out" class="icon-button" type="button" aria-label="缩小" title="缩小" disabled>
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10"></path></svg>
						</button>
						<button id="zoom-reset" class="zoom-level" type="button" title="恢复默认大小" disabled></button>
						<button id="zoom-in" class="icon-button" type="button" aria-label="放大" title="放大" disabled>
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M10 5v10"></path></svg>
						</button>
					</div>

					<button id="menu-toggle" class="icon-button" type="button" aria-label="更多" title="更多" aria-expanded="false" aria-controls="menu-panel">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path class="dots" d="M4.5 10h.01M10 10h.01M15.5 10h.01"></path></svg>
					</button>
				</header>

				<nav class="tools" aria-label="阅读工具">
					<button id="outline-toggle" class="tool" type="button" aria-expanded="false" aria-controls="outline-panel">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5.5h12M4 10h12M4 14.5h8"></path></svg>
						<span>目录</span>
					</button>
					<button id="find-toggle" class="tool" type="button" aria-expanded="false" aria-controls="find-bar" title="在文中查找 (Ctrl/⌘ F)" disabled>
						<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5"></circle><path d="m12.5 12.5 4 4"></path></svg>
						<span>查找</span>
					</button>
					<button id="compare-toggle" class="tool" type="button" aria-pressed="false">
						<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="1.5"></rect><path d="M10 4v12"></path></svg>
						<span id="compare-label"></span>
					</button>
					<button id="region-toggle" class="tool" type="button" aria-pressed="false" title="框选图表或公式，放大查看" disabled>
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 7V3.5H7M13 3.5h3.5V7M16.5 13v3.5H13M7 16.5H3.5V13M10 7.5v5M7.5 10h5"></path></svg>
						<span>放大</span>
					</button>
					<label class="pager">
						<span class="sr-only">页码</span>
						<input id="page-number" type="number" inputmode="numeric" min="1" value="1" disabled />
						<span id="page-count">{variant === 'zh' ? `/ ${paper.pages}` : ''}</span>
					</label>
				</nav>
			</div>

			<div id="find-bar" class="find-bar" role="search" hidden>
				<input id="find-input" type="search" placeholder="在文中查找" aria-label="在文中查找" autocomplete="off" enterkeyhint="search" />
				<span id="find-count" class="find-count" aria-live="polite"></span>
				<button id="find-previous" class="icon-button" type="button" aria-label="上一处" title="上一处 (Shift Enter)" disabled>
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12.5 5-5 5 5"></path></svg>
				</button>
				<button id="find-next" class="icon-button" type="button" aria-label="下一处" title="下一处 (Enter)" disabled>
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"></path></svg>
				</button>
				<button id="find-close" class="icon-button" type="button" aria-label="关闭查找" title="关闭 (Esc)">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9"></path></svg>
				</button>
			</div>

			<aside id="outline-panel" class="sheet outline" aria-label="章节目录" hidden>
				<div class="sheet-head">
					<strong>目录</strong>
					<span id="outline-version" class="muted"></span>
					<button class="icon-button" type="button" aria-label="关闭目录" data-close>
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9"></path></svg>
					</button>
				</div>
				<div id="outline-list" class="outline-list"></div>
			</aside>

			<div id="menu-panel" class="sheet menu" hidden>
				<button id="copy-link" type="button">复制当前位置的链接</button>
				<button id="switch-version" type="button" hidden></button>
				<div class="menu-row" data-keep-open>
					<span>页面大小</span>
					<span class="segmented">
						<button id="fit-text" type="button" aria-pressed="false" title="裁掉页边距，让正文占满屏幕">适合正文</button>
						<button id="fit-width" type="button" aria-pressed="false">整页宽度</button>
					</span>
				</div>
				<button id="clean-copy-toggle" class="menu-switch" type="button" aria-pressed="true" data-keep-open>
					<span>复制时把断行合并成段落</span>
					<span class="switch" aria-hidden="true"></span>
				</button>
				<hr />
				<a id="download-link" href={config.main.url} download>下载 PDF</a>
				{config.originalSource && (
					<a href={config.originalSource} target="_blank" rel="noopener noreferrer">
						原文来源 ↗
					</a>
				)}
				{config.notice && <button id="notice-open" type="button">关于这份文件</button>}
				<a href={paperUrl(paper.id)}>论文详情</a>
			</div>
			<div id="sheet-backdrop" class="backdrop" hidden></div>

			<main id="panes" class="panes">
				<section id="primary-pane" class="pane" aria-label="阅读区">
					<div id="primary-viewer" class="viewer-container" tabindex="0"><div class="pdfViewer"></div></div>
					<!-- The link stays visible while loading, as a way out if the reader never starts. -->
					<div class="load-status" role="status">
						<span class="load-message">正在加载…</span>
						<a href={config.main.url}>直接打开 PDF</a>
					</div>
				</section>

				<section id="side-pane" class="pane side" aria-label="并排阅读区" hidden>
					<div class="pane-head">
						<span id="side-label" class="muted" hidden>本文另一处</span>
						<span id="side-choice" class="segmented">
							<button id="side-other" type="button" aria-pressed="false"></button>
							<button id="side-same" type="button" aria-pressed="false" title="同一份文件的另一处，例如一边读正文一边看图表">本文另一处</button>
						</span>
						<button id="sync-toggle" class="chip" type="button" aria-pressed="true" title="滚动一边时，另一边跟到对应的章节位置">同步滚动</button>
						<button id="side-close" class="icon-button" type="button" aria-label="关闭并排阅读" title="关闭">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9"></path></svg>
						</button>
					</div>
					<div id="side-viewer" class="viewer-container" tabindex="0"><div class="pdfViewer"></div></div>
					<div class="load-status" role="status">
						<span class="load-message">正在加载…</span>
						<a href={config.main.url}>直接打开 PDF</a>
					</div>
				</section>
			</main>

			{config.notice && (
				<div id="notice" class="notice" role="note" hidden>
					<p>{config.notice}</p>
					<button id="notice-dismiss" type="button">知道了</button>
				</div>
			)}

			<div id="back-chip" class="back-chip" hidden>
				<button id="back-button" type="button" title="回到跳转前的位置 (Alt ←)"></button>
				<button id="back-dismiss" type="button" aria-label="不需要返回">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
				</button>
			</div>

			<div id="region-hint" class="region-hint" role="status" hidden>
				<span>拖动框选要放大的图表或公式</span>
				<button id="region-cancel" type="button">取消</button>
			</div>
			<div id="region-box" class="region-box" hidden></div>

			<dialog id="region-dialog" class="region-dialog" aria-label="放大查看">
				<header>
					<span id="region-label" class="muted"></span>
					<button id="region-out" class="icon-button" type="button" aria-label="缩小" title="缩小" disabled>
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10"></path></svg>
					</button>
					<button id="region-in" class="icon-button" type="button" aria-label="放大" title="放大">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M10 5v10"></path></svg>
					</button>
					<button id="region-close" class="icon-button" type="button" aria-label="关闭" title="关闭 (Esc)">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9"></path></svg>
					</button>
				</header>
				<div id="region-stage" class="region-stage"><canvas id="region-canvas"></canvas></div>
			</dialog>

			<dialog id="link-dialog" class="link-dialog" aria-labelledby="link-heading">
				<h2 id="link-heading">当前位置的链接</h2>
				<p>浏览器没有允许自动复制，请手动复制：</p>
				<input id="link-field" type="text" readonly aria-label="链接" />
				<form method="dialog"><button>关闭</button></form>
			</dialog>

			<div id="reader-toast" class="toast" role="status" aria-live="polite"></div>

			<noscript>
				<p class="noscript">在线阅读需要启用 JavaScript。<a href={config.main.url}>直接打开 PDF</a></p>
			</noscript>
		</div>

		<script>
			import '../scripts/reader/main.ts';
		</script>
	</body>
</html>

<style is:global>
	/* Global because the chapter list and the PDF pages are created by scripts. */
	.reader {
		--bar: 48px;
		--tools: 0px;
		--desk: #e9e9ec;
		position: fixed;
		inset: 0;
		background: var(--desk);
		color: var(--fg);
		font-size: 14px;
		line-height: 1.5;
	}
	.reader [hidden] {
		display: none !important;
	}
	.reader button,
	.reader input {
		font: inherit;
		color: inherit;
	}
	.reader button {
		margin: 0;
		padding: 0;
		background: none;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		touch-action: manipulation;
	}
	.reader button:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.reader :focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.reader svg {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.reader svg .dots {
		stroke-width: 2.6;
	}
	.reader .muted {
		color: var(--fg-muted);
		font-size: 12px;
	}

	/* --- Toolbar ------------------------------------------------------------- */

	.chrome {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 20;
		height: var(--bar);
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 0 8px;
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border);
	}
	/* On wide screens the header and the tools share one row. */
	.bar {
		display: contents;
	}
	.bar .back {
		order: 1;
	}
	.title {
		order: 2;
		flex: 1;
		min-width: 0;
		margin: 0 8px 0 4px;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tools {
		order: 3;
		display: flex;
		align-items: center;
		gap: 2px;
	}
	.zoom {
		order: 4;
		display: flex;
		align-items: center;
		margin-left: 6px;
	}
	#menu-toggle {
		order: 5;
	}
	.reader .icon-button,
	.reader .tool {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		height: 36px;
		min-width: 36px;
		color: var(--fg-secondary);
		text-decoration: none;
		border-radius: 6px;
		white-space: nowrap;
	}
	.reader .tool {
		padding: 0 10px;
	}
	.reader .icon-button:hover:not(:disabled),
	.reader .tool:hover:not(:disabled) {
		color: var(--fg);
		background: var(--code-bg);
		text-decoration: none;
	}
	.reader .tool[aria-pressed='true'],
	.reader .tool[aria-expanded='true'] {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}
	.reader .zoom-level {
		min-width: 52px;
		height: 36px;
		color: var(--fg-secondary);
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}
	.reader .zoom-level:hover:not(:disabled) {
		background: var(--code-bg);
	}
	.pager {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-left: 6px;
		color: var(--fg-muted);
		font-size: 13px;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.reader #page-number {
		width: 46px;
		height: 30px;
		padding: 0 4px;
		/* 16px keeps iOS from zooming the page when the field is focused. */
		font-size: 16px;
		text-align: center;
		color: var(--fg);
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		appearance: textfield;
		-moz-appearance: textfield;
	}
	#page-number::-webkit-outer-spin-button,
	#page-number::-webkit-inner-spin-button {
		appearance: none;
		margin: 0;
	}

	/* --- Panes --------------------------------------------------------------- */

	.panes {
		position: absolute;
		inset: var(--bar) 0 0 0;
		display: flex;
		/* The site's article column styles apply to every <main>; the reader fills the screen. */
		width: auto;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.pane {
		position: relative;
		flex: 1;
		min-width: 0;
	}
	.pane + .pane {
		border-left: 1px solid var(--border);
	}
	/* With two panes, a line marks the one the toolbar works on. */
	.split .pane.active::after {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 2px;
		background: var(--accent);
		pointer-events: none;
	}
	.viewer-container {
		/* PDF.js requires its scroll container to be absolutely positioned. */
		position: absolute;
		inset: 0;
		overflow: auto;
		overscroll-behavior: contain;
		padding-top: 10px;
		/* It takes focus so that the keyboard scrolls it; a ring around the page adds nothing. */
		outline: none !important;
	}
	.side .viewer-container {
		top: 36px;
	}
	.pane-head {
		position: absolute;
		inset: 0 0 auto 0;
		height: 36px;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 4px 0 8px;
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border);
	}
	.pane-head .icon-button {
		height: 30px;
		min-width: 30px;
		margin-left: auto;
	}
	.reader .pdfViewer .page {
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
	}
	/* LaTeX draws coloured boxes around links. They stay clickable without the boxes. */
	.reader .annotationLayer .linkAnnotation {
		border-color: transparent !important;
	}
	/* A match that is scrolled to should not end up under the toolbar. */
	.reader .textLayer .highlight {
		scroll-margin-top: 96px;
	}
	.load-status {
		position: absolute;
		inset: 0 0 auto 0;
		padding: 64px 16px;
		text-align: center;
		color: var(--fg-secondary);
	}
	.side .load-status {
		top: 36px;
	}
	.load-status a {
		margin-left: 8px;
	}

	/* --- Small controls ------------------------------------------------------ */

	.segmented {
		display: inline-flex;
		padding: 2px;
		background: var(--code-bg);
		border-radius: 7px;
	}
	.reader .segmented button {
		height: 26px;
		padding: 0 10px;
		font-size: 13px;
		color: var(--fg-secondary);
		border-radius: 5px;
	}
	.reader .segmented button[aria-pressed='true'] {
		color: var(--fg);
		background: var(--bg-surface);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
	}
	.reader .chip {
		height: 26px;
		padding: 0 10px;
		font-size: 13px;
		color: var(--fg-muted);
		border: 1px solid var(--border);
		border-radius: 999px;
	}
	.reader .chip[aria-pressed='true'] {
		color: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}

	/* --- Chapter list and menu ----------------------------------------------- */

	.sheet {
		position: absolute;
		z-index: 40;
		display: flex;
		flex-direction: column;
		background: var(--bg-surface);
	}
	.sheet-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 6px 6px 14px;
		border-bottom: 1px solid var(--border-light);
	}
	.sheet-head .icon-button {
		margin-left: auto;
	}
	.backdrop {
		position: absolute;
		inset: 0;
		z-index: 30;
	}
	.outline {
		top: var(--bar);
		bottom: 0;
		left: 0;
		z-index: 10;
		width: 280px;
		border-right: 1px solid var(--border);
	}
	.outline-open .panes {
		left: 280px;
	}
	.outline-list {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 6px;
	}
	.reader .outline-item {
		display: flex;
		align-items: baseline;
		gap: 10px;
		width: 100%;
		padding: 6px 8px 6px calc(8px + var(--level) * 14px);
		font-size: 13px;
		line-height: 1.45;
		text-align: left;
		color: var(--fg-secondary);
	}
	.outline-item:hover {
		background: var(--code-bg);
	}
	.outline-item span:first-child {
		flex: 1;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.outline-item[aria-current='true'] {
		color: var(--accent);
		font-weight: 600;
		background: color-mix(in srgb, var(--accent) 9%, transparent);
	}
	.outline-page {
		color: var(--fg-muted);
		font-size: 12px;
		font-weight: 400;
		font-variant-numeric: tabular-nums;
	}
	.outline-empty {
		margin: 0;
		padding: 12px 8px;
		color: var(--fg-muted);
	}
	.menu {
		top: calc(var(--bar) + 4px);
		right: 8px;
		width: 280px;
		padding: 6px;
		border: 1px solid var(--border);
		border-radius: 10px;
		box-shadow: 0 8px 28px rgb(0 0 0 / 0.14);
	}
	.reader .menu > button,
	.menu > a,
	.menu-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		width: 100%;
		min-height: 38px;
		padding: 0 10px;
		text-align: left;
		color: var(--fg);
		text-decoration: none;
		border-radius: 6px;
	}
	.menu > button:hover,
	.menu > a:hover {
		background: var(--code-bg);
		text-decoration: none;
	}
	.menu hr {
		margin: 6px 0;
