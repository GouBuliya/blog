---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Compare paths relative to the site base, so `/blog/about` matches the page `/blog/about/`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stripBase = (path: string) => (path.startsWith(base) ? path.slice(base.length) : path) || '/';
const pathname = stripBase(Astro.url.pathname);
const target = stripBase(String(href));
const subpath = pathname.match(/[^\/]+/g);
const isActive = target === pathname || target === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
