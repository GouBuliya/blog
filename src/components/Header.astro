---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href={`${import.meta.env.BASE_URL}/`}>{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href={`${import.meta.env.BASE_URL}/`}>Home</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/about`}>About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/GouBuliya" target="_blank" title="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		max-width: var(--content-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		gap: 1rem;
	}
	.site-title {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--fg);
		text-decoration: none;
		white-space: nowrap;
	}
	.site-title:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		gap: 0.25rem;
	}
	.nav-links :global(a) {
		padding: 0.35rem 0.7rem;
		border-radius: 6px;
		font-size: 0.9rem;
		color: var(--fg-secondary);
		text-decoration: none;
		transition: background 0.15s, color 0.15s;
	}
	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		background: var(--code-bg);
		color: var(--fg);
		text-decoration: none;
	}
	.social-links {
		display: flex;
		align-items: center;
	}
	.social-links a {
		color: var(--fg-muted);
		padding: 0.35rem;
		border-radius: 6px;
		display: flex;
		transition: color 0.15s;
	}
	.social-links a:hover {
		color: var(--fg);
		text-decoration: none;
	}
	@media (max-width: 720px) {
		nav { padding: 0.6rem 1rem; }
		.social-links { display: none; }
	}
</style>
