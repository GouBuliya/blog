---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1>GouBuliya</h1>
        <p class="tagline">Born 2009 &middot; Continual learning researcher &middot; Foundation model intern</p>
      </section>

      <section class="recent">
        <h2>Recent Posts</h2>
        <ul class="post-list">
          {recentPosts.map((post) => (
            <li>
              <a href={`${import.meta.env.BASE_URL}/${post.id}/`}>
                <span class="post-title">{post.data.title}</span>
                <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
              </a>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
            </li>
          ))}
        </ul>
        <a class="all-posts-link" href={`${import.meta.env.BASE_URL}/blog`}>All posts &rarr;</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero {
    padding: 3rem 0 2rem;
  }
  .hero h1 {
    font-size: 2rem;
    margin: 0 0 0.4rem;
  }
  .tagline {
    color: var(--fg-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .recent {
    margin-top: 0.5rem;
  }
  .recent h2 {
    font-size: 1.1rem;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-light);
  }
  .post-list li:last-child { border-bottom: none; }
  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    text-decoration: none;
  }
  .post-title {
    color: var(--fg);
    font-weight: 600;
  }
  .post-list a:hover .post-title { color: var(--accent); }
  .post-date {
    color: var(--fg-muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .post-desc {
    color: var(--fg-secondary);
    font-size: 0.9rem;
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }
  .all-posts-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .hero { padding: 2rem 0 1.5rem; }
    .hero h1 { font-size: 1.6rem; }
    .post-list a { flex-direction: column; gap: 0.15rem; }
  }
</style>
