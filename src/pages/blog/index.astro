---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">All Posts</h1>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`}>
							<span class="post-title">{post.data.title}</span>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
						{post.data.description && <p class="post-desc">{post.data.description}</p>}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		font-size: 1.6rem;
		margin: 0 0 1.5rem;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li {
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border-light);
	}
	.post-list li:last-child { border-bottom: none; }
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		text-decoration: none;
	}
	.post-title {
		color: var(--fg);
		font-weight: 600;
		font-size: 1.05rem;
	}
	.post-list a:hover .post-title { color: var(--accent); }
	.post-date {
		color: var(--fg-muted);
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.post-desc {
		color: var(--fg-secondary);
		font-size: 0.9rem;
		margin: 0.25rem 0 0;
		line-height: 1.5;
	}
	@media (max-width: 720px) {
		.post-list a { flex-direction: column; gap: 0.15rem; }
	}
</style>
